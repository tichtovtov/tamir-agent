# Copy this file to .env and fill in the values.
# Only TELEGRAM_BOT_TOKEN is required; everything else has a default.

# Bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Name shown to unauthorized users ("send your ID to ...")
ADMIN_NAME=אלעד

# Default target currency for new users (ISO 4217 code)
DEFAULT_CURRENCY=ILS

# Address of the Ollama server. Local run: http://localhost:11434
# In Docker, docker-compose.yml overrides it to http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434

# Vision model in Ollama for reading prices from images (must be pulled first: ollama pull <model>)
OLLAMA_MODEL=gemma3:12b

# Language model in Ollama for understanding free-text messages and asking clarifying
# questions. Leave empty to use OLLAMA_MODEL for text too (recommended with gemma3:12b,
# which handles Hebrew well; one model = less memory).
OLLAMA_TEXT_MODEL=

# Max seconds to wait for Ollama per request
OLLAMA_TIMEOUT=90

# Directory for allowed_users.json and user_prefs.json
DATA_DIR=data

# How long (seconds) exchange rates are cached
RATES_TTL=3600

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
